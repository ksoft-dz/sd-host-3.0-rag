@startuml
start

:(1) Check S18A;
if (S18A=0) then (yes)
  stop
else (S18A=1)
  :(2) Voltage Switch (CMD11);
  
  if ((3) Response OK?) then (Yes)
    :(4) SD Clock Enable = 0;
    
    if ((5) Check DAT[3:0]) then (0000b)
      :(6) 1.8V Signal Enable = 1;
      
      :(7) Wait 5ms;
      
      if ((8) Check 1.8V\nSignal Enable) then (1)
        :(9) SD Clock Enable = 1;
        
        :(10) Wait 1ms;
        
        if ((11) Check DAT[3:0]) then (1111b)
          stop
        else (Not 1111b)
          :(12) SD Bus Power = 0;
          :Stop;
          detach
        endif
      else (0)
        detach
      endif
    else (Not 0000b)
      detach
    endif
  else (No)
    detach
  endif
endif

@enduml
@startuml
skinparam monochrome true

map "SOFTWARERESET Register" as reg {
  Offset => 0x002F
  Access => Read/Write
}

rectangle "8-bit Register Layout" {
  rectangle "Bit 7" as b7
  rectangle "Bit 6" as b6
  rectangle "Bit 5" as b5
  rectangle "Bit 4" as b4
  rectangle "Bit 3" as b3
  rectangle "Bit 2" as b2
  rectangle "Bit 1" as b1
  rectangle "Bit 0" as b0
}

note bottom of b7
  **SWRESET_FOR_ALL**
  R: 0
  W: -
  Reset: 0
end note

note bottom of b6
  **SWRESET_FOR_CMD**
  R: 0
  W: -
  Reset: 0
end note

note bottom of b5
  **SWRESET_FOR_DAT**
  R: 0
  W: -
  Reset: 0
end note

note bottom of b4
  Reserved
  R: 0
  W: 0
  Reset: 0
end note

note bottom of b3
  Reserved
  R: 0
  W: 0
  Reset: 0
end note

note bottom of b2
  Reserved
  R: 0
  W: 0
  Reset: 0
end note

note bottom of b1
  Reserved
  R: 0
  W: 0
  Reset: 0
end note

note bottom of b0
  Reserved
  R: 0
  W: 0
  Reset: 0
end note

@enduml
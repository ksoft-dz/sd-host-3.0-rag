@startuml
skinparam monochrome true
skinparam defaultFontSize 10

title FORCEEVENTFORERRINTSTS Register (Offset: 0x0052) - Access: Write only

map "Reset" as reset {
}

map "Write (W)" as write {
  15 => FORCE\nCMDTIMEOUTERR
  14 => FORCE\nCMDCRCERR
  13 => FORCE\nCMDENDBITERR
  12 => FORCE\nCMDINDEXERR
  11 => FORCE\nDATTIMEOUTERR
  10 => FORCE\nDATCRCERR
  9 => FORCE\nDATENDBITERR
  8 => FORCE\nCURRLIMERR
  7 => FORCE\nAUTOCMDERR
  6 => FORCE\nADMAERR
  5 => 0
  4 => 0
  3 => 0
  2 => 0
  1 => 0
  0 => 0
}

note bottom
  Bit positions:
  [15:6] - Various FORCE error interrupt bits
  [5:0] - Reserved (0)
  
  Reset value: All bits = 0
end note

@enduml
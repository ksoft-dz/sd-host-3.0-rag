  rectangle "Bit 13\n0" as bit13
  rectangle "Bit 12\n0" as bit12
  rectangle "Bit 11\n0" as bit11
  rectangle "Bit 10\n0" as bit10
  rectangle "Bit 9\n0" as bit9
  rectangle "Bit 8\n0" as bit8
  rectangle "Bit 7\n0" as bit7
  rectangle "Bit 6\n0" as bit6
  rectangle "Bit 5\n0" as bit5
  rectangle "Bit 4\n0" as bit4
  rectangle "Bit 3\n0" as bit3
  rectangle "Bit 2\n0" as bit2

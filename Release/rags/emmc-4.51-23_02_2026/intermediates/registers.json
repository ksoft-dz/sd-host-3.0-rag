      "id": "REG_001",
      "name": "OCR Register",
      "offset": "001h",
      "spec_section": "7.1",
      "spec_table": "TABLE_63",
      "class_id": "REGCLASS_OPER_COND",
      "fields": [
        {
          "id": "REG_001_F1",
          "name": "1.70-1.95V",
          "bits": "[7]",
          "bit_high": 7,
          "bit_low": 7,
          "width": 1,
          "access": "read-only",
          "original_attrib": "R",
          "raw": "0b (High Voltage MultimediaCard) / 1b (Dual voltage MultiMediaCard and e•MMC)",
          "abstract": "Indicates whether the card supports dual voltage operation (1.70-1.95V range) for Dual voltage MultiMediaCard/e•MMC (1) or only high voltage operation for standard MultiMediaCard (0).",
          "values": []
        },
        {
          "id": "REG_001_F2",
          "name": "2.0-2.6V",
          "bits": "[14:8]",
          "bit_high": 14,
          "bit_low": 8,
          "width": 7,
          "access": "read-only",
          "original_attrib": "R",
          "raw": "000 0000b (High Voltage MultimediaCard) / 000 0000b (Dual voltage MultiMediaCard and e•MMC)",
          "abstract": "Indicates voltage support status in the 2.0-2.6V range for High Voltage, Dual Voltage, and e•MMC cards (read-only, 7-bit field).",
          "values": []
        },
        {
          "id": "REG_001_F3",
          "name": "2.7-3.6V",
          "bits": "[23:15]",
          "bit_high": 23,
          "bit_low": 15,
          "width": 9,
          "access": "read-only",
          "original_attrib": "R",
          "raw": "1 1111 1111b (High Voltage MultimediaCard) / 1 1111 1111b (Dual voltage MultiMediaCard and e•MMC)",
          "abstract": "Indicates support for 2.7-3.6V voltage range in the card's operating conditions register (OCR), with all bits set indicating full voltage range support for High Voltage, Dual Voltage, and e•MMC cards.",
          "values": []
        },
        {
          "id": "REG_001_F5",
          "name": "Access mode",
          "bits": "[30:29]",
          "bit_high": 30,
          "bit_low": 29,
          "width": 2,
          "access": "read-only",
          "original_attrib": "R",
          "raw": "00b (byte mode) 10b (sector mode) (High Voltage MultimediaCard) / 00b (byte mode) 10b (sector mode) (Dual voltage MultiMediaCard and e•MMC)",
          "abstract": "Indicates the memory card's access mode, where 00b selects byte addressing mode and 10b selects sector addressing mode for High Voltage, Dual Voltage, and e•MMC MultiMediaCard types.",
          "values": []
        },
        {
          "id": "REG_001_F6",
          "name": "Card power up status bit (busy)",
          "bits": "[31]",
          "bit_high": 31,
          "bit_low": 31,
          "width": 1,
          "access": "read-only",
          "original_attrib": "R",
          "raw": "This bit is set to LOW if the Device has not finished the power up routine",
          "abstract": "Indicates whether the device power-up routine is complete, where LOW (0) means power-up is still in progress and the device is busy.",
          "values": []
        }
      ],

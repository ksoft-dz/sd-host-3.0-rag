@startuml
robust "CMD" as CMD
robust "DAT0-7" as DAT

scale 1 as 60 pixels

@0
CMD is "S"
DAT is "Z"

@1
CMD is "T"
DAT is "Z"

@2
CMD is "Content"
DAT is "Z"

@6
CMD is "CRC"
DAT is "* * * *"

@8
CMD is "E"
DAT is "Z"

@9
CMD is "Z"
DAT is "Z"

@10
CMD is "Z"
DAT is "Z"

@11
CMD is "P"
DAT is "Z"

@12
CMD is "* * *"
DAT is "Z"

@14
CMD is "P"
DAT is "Z"

@15
CMD is "S"
DAT is "P"

@16
CMD is "T"
DAT is "* * * * * * * * * *"

@17
CMD is "Content"

@21
CMD is "CRC"
DAT is "P"

@23
CMD is "E"
DAT is "S"

@24
DAT is "D"

@25
DAT is "D"

@26
DAT is "D"

@27
DAT is "* * *"

note top of CMD : <-- Host Command --> <-- N_CR cycles --> <-- Response -->
note top of DAT : <-- N_AC cycles --> <-- Read Data -->

@enduml
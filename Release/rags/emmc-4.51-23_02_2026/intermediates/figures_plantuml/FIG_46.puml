DAT1_7 is "Z"

@1
CMD is "Z"
DAT0 is "Z"
DAT1_7 is "Z"

@2
CMD is "Z"
DAT0 is "Z"
DAT1_7 is "Z"

@3
CMD is "Z"
DAT0 is "Z"
DAT1_7 is "Z"

@4
CMD is "S"
DAT0 is "Z"
DAT1_7 is "Z"

@5
CMD is "***"
DAT0 is "***"
DAT1_7 is "***"

@6
DAT0 is "Z|S|0|1|0|E|P"
DAT1_7 is "Z|X"

@7
DAT0 is "***"
DAT1_7 is "***"

@8
DAT0 is "X|P"
DAT1_7 is "X|P"

@9
DAT0 is "***"
DAT1_7 is "***"

@10
DAT0 is "P|S"
DAT1_7 is "P|S"

@11

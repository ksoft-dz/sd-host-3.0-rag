@startuml
skinparam monochrome true
skinparam defaultTextAlignment center

title Maximum Current Capabilities Register (Offset 048h)

package "Register Bit Layout" {
  card "D63 .................................................. D32" as upper
  note right of upper
    Rsvd
  end note
  
  card "D31..D24 | D23........D16 | D15........D08 | D07........D00" as lower
  note right of lower
    Rsvd | Max Current 1.8V | Max Current 3.0V | Max Current 3.3V
  end note
}

@enduml

@startuml
skinparam monochrome true

title Table 2-35: Maximum Current Capabilities Register


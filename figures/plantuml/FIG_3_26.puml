@startuml
title Figure 3-26 : The Sequence for Resume

start

:(1) Restore Register (000-00Dh);

:(2) Issue Resume Command;

:(3) Check Data Flag (DF);

if (DF?) then (DF=0)
  :(4) Set Software Reset For DAT line (DR);
  
  repeat
    :(5) Check DR;
  repeat while (DR=1) is (DR=1)
  ->DR=0;
else (DF=1)
endif

stop

@enduml
@startuml
skinparam defaultTextAlignment center
skinparam componentStyle rectangle

title SD Host Controller Simplified Specification Version 3.00

' Slot Interrupt Status Register
package "2.2.33 Slot Interrupt Status Register (Offset 0FCh)" {
  
  component "Figure 2-39: Slot Interrupt Status Register" as SlotIntRegister {
    card "D15 ... D08 D07 ... D00" as bits1
    card "Rsvd | Interrupt Signal For Each Slot" as fields1
  }
  
  note right of SlotIntRegister
    **Table 2-45: Slot Interrupt Status Register**
    
    **Location 15-08 | Attrib: Rsvd**
    **Reserved**
    
    **Location 07-00 | Attrib: ROC**
    **Interrupt Signal For Each Slot**
    These status bits indicate the logical OR of Interrupt Signal and Wakeup
    Signal for each slot. A maximum of 8 slots can be defined. If one interrupt
    signal is associated with multiple slots, the Host Driver can know which
    interrupt is generated by reading these status bits. By a power on reset or by
    setting **Software Reset For All**, the interrupt signal shall be de-asserted
    and this status shall read 00h.
    
    | Bit 00 | Slot 1 |
    | Bit 01 | Slot 2 |
    | Bit 02 | Slot 3 |
    | ....... | ....... |
    | Bit 07 | Slot 8 |
  end note
}

' Host Controller Version Register
package "2.2.34 Host Controller Version Register (Offset 0FEh)" {
  
  component "Figure 2-40: Host Controller Version Register" as VersionRegister {
    card "D15 ... D08 D07 ... D00" as bits2
    card "Vendor Version Number | Specification Version Number" as fields2
  }
  
  note right of VersionRegister
    **Table 2-46: Host Controller Version**
    
    **Location 15-08 | Attrib: HwInit**
    **Vendor Version Number**
    This status is reserved for the vendor version number. The Host Driver
    should not use this status.
    
    **Location 07-00 | Attrib: HwInit**
    **Specification Version Number**
    This status indicates the Host Controller Spec. Version. The upper and
    lower 4-bits indicate the version.
    
    | 00h | SD Host Specification Version 1.00 |
    | 01h | SD Host Specification Version 2.00 |
    |     | Including the feature of the ADMA and Test Register, |
    | 02h | SD Host Specification Version 3.00 |
    | others | Reserved |
  end note
}

@enduml